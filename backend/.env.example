# Set a private random value for production. The backend has a development fallback.
JWT_SECRET=replace-with-a-private-random-secret-of-at-least-32-characters

# Required for OTP email delivery through Resend.
RESEND_API_KEY=re_your_resend_api_key

# Required to open the registered-candidates directory from the admin portal.
# Use a separate private random value of at least 32 characters.
ADMIN_API_KEY=replace-with-a-private-admin-key-of-at-least-32-characters

# Optional. Defaults to backend/data/candidates.json.
# Point this at durable shared storage when deploying across serverless instances.
# AUTH_USERS_FILE=C:\path\to\candidates.json

# Optional. Defaults to backend/data/applications.json.
# Store this on the same durable volume used for AUTH_USERS_FILE.
# APPLICATIONS_FILE=C:\path\to\applications.json
